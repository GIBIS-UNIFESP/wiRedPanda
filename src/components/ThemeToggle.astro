---
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, useTranslations } from '../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

{
  /*
  Both icons are always rendered and CSS picks one off the `dark` class that
  Base.astro's inline script sets before first paint, so the correct icon is
  right on the very first frame. Choosing it in the script below instead would
  paint the wrong one and visibly swap it after hydration.

  `flex` is load-bearing, not cosmetic: an inline element wrapping only an
  <Icon> gets fragmented into several line boxes by the whitespace text nodes
  around it, and the keyboard focus ring is drawn around their union -- see
  6adaf78b3, which fixed exactly that on the GitHub nav link.
*/
}
<button
  type="button"
  class="theme-switch"
  aria-label={t('theme.toggle')}
  role="switch"
  aria-checked="false"
  ><Icon name="moon" class="theme-icon theme-icon-moon" /><Icon
    name="sun"
    class="theme-icon theme-icon-sun"
  /></button
>

<style>
  .theme-switch {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-gray-500, #6b7280);
    transition: color 0.2s ease;
  }

  .theme-switch:hover {
    color: var(--color-gray-900, #111827);
  }

  :global(.dark) .theme-switch {
    color: var(--color-gray-300, #d1d5db);
  }

  :global(.dark) .theme-switch:hover {
    color: #fff;
  }

  .theme-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Light: offer the moon (switch to dark). Dark: offer the sun. */
  .theme-icon-sun {
    display: none;
  }

  :global(.dark) .theme-icon-moon {
    display: none;
  }

  :global(.dark) .theme-icon-sun {
    display: block;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-preparation', () => controller.abort(), { once: true });

    const btns = document.querySelectorAll<HTMLButtonElement>('.theme-switch');

    function updateAria() {
      const isDark = document.documentElement.classList.contains('dark');
      btns.forEach((btn) => btn.setAttribute('aria-checked', String(isDark)));
    }

    updateAria();

    btns.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateAria();
        },
        { signal }
      );
    });
  });
</script>
